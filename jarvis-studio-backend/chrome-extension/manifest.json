{
  "manifest_version": 3,
  "name": "JARVIS in Chrome",
  "version": "1.0.0",
  "description": "Lets JARVIS's browser agent work in tabs it opens in your Chrome, where you're signed in. Talks only to JARVIS on this PC.",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "JARVIS isn't running" },
  "minimum_chrome_version": "116"
}
